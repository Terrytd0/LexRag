# Copy to .env and fill in real values for your environment:
#   cp .env.example .env
# .env is gitignored -- never commit real credentials. Every variable here is
# loaded by configs/settings.py via pydantic-settings; see that module for
# defaults, and docs/architecture.md for why each backend/model was chosen.

# --- LLM provider ---
# Credential for the active LLM_PROVIDER (below). Named OPENAI_API_KEY
# because the OpenAI SDK -- our default provider -- reads this env var
# automatically. generation/ consumes it through a provider-agnostic
# interface (docs/architecture.md 2.9), so this is the one name in this
# file that's tied to a specific provider rather than our own config.
OPENAI_API_KEY=

# --- MongoDB: raw document text + chunk provenance metadata ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lexrag

# --- Qdrant: dense vector store ---
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud. Leave blank for a local/self-hosted instance
# with no auth (the default for the Day 2 docker-compose.yml service).
QDRANT_API_KEY=
QDRANT_COLLECTION=lexrag_chunks
# One of Qdrant's Distance enum values: Cosine, Dot, Euclid.
QDRANT_DISTANCE_METRIC=Cosine

# --- Elasticsearch: BM25 keyword index ---
ELASTICSEARCH_URL=http://localhost:9200
# Basic auth credentials. Leave both blank for a local cluster running with
# security disabled (the default for the Day 2 docker-compose.yml service).
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=lexrag_chunks

# --- Embeddings ---
# Dense embedding model (served locally via sentence-transformers). bge-m3
# supports up to 8192 input tokens and multilingual text, which matters for
# long legal filings that a 512-token-limited model would truncate.
EMBEDDING_MODEL=BAAI/bge-m3
# Must match EMBEDDING_MODEL's output dimensionality -- the Qdrant
# collection is created with this vector size. bge-m3's dense output is 1024.
EMBEDDING_DIMENSIONS=1024
# Chunks per encode() call in EmbeddingService -- balances throughput against
# peak memory during ingestion.
EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Hybrid retrieval ---
# Reciprocal Rank Fusion constant merging the vector + BM25 ranked lists.
RRF_K=60
# Candidates pulled from each of Qdrant/Elasticsearch before RRF fusion.
RETRIEVAL_TOP_K=50
# Cross-encoder reranking model applied to the RRF-fused candidate set.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Reranked candidates passed into generation.
RERANK_TOP_K=8

# --- Generation ---
# "openai" is the only provider implemented today; generation/ talks to it
# through a provider-agnostic interface, not a hardcoded SDK call.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Minimum reranker relevance score required before generation runs. Below
# this, POST /query returns a refusal instead of an answer (FR-10).
GENERATION_MIN_CONTEXT_SCORE=0.35

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Read by `uv run python -m api` (see api/__main__.py); ignored if you launch
# uvicorn directly with your own --host/--port flags.
APP_HOST=0.0.0.0
APP_PORT=8000
